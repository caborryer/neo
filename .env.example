# ── API ──────────────────────────────────────────────
API_PORT=3000
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://neo:neo@localhost:5432/neo?schema=public

# Secretos (mínimo 32 caracteres). Genera uno con: openssl rand -hex 32
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-largo-de-32-caracteres-o-mas
JWT_REFRESH_SECRET=cambia-esto-por-otro-secreto-largo-de-32-caracteres-o-mas
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

# ── Coach única (la crea el seed) ───────────────────
SEED_COACH_EMAIL=coach@neo.local
SEED_COACH_PASSWORD=CambiaEstaClave123!
SEED_COACH_FIRST_NAME=Coach
SEED_COACH_LAST_NAME=Neo

# ── Almacenamiento S3 compatible (MinIO en desarrollo) ──
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=neo-private
S3_ACCESS_KEY=neo
S3_SECRET_KEY=neo-secret-key
S3_MAX_UPLOAD_MB=5

# ── Correo (Mailpit en desarrollo: http://localhost:8025) ──
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Neo <no-reply@neo.local>"

# ── Cookies de sesión ────────────────────────────────
# Secure por defecto solo en producción; déjalo vacío en local (http).
# COOKIE_SECURE=false

# ── Frontend ─────────────────────────────────────────
VITE_API_URL=/api/v1

# ── Producción / operación ───────────────────────────
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false      # true para el puerto 465
# TRUST_PROXY=1          # saltos de proxy de confianza (Caddy = 1)
# HTTP_LOG=true          # false silencia el log de peticiones
# DISABLE_RATE_LIMIT=    # SOLO pruebas E2E; se rechaza en producción
