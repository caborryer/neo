# Web estática servida por Caddy para Railway (HTTP en $PORT; Railway pone el HTTPS) que también reenvía /api a la API.
#   docker build -f apps/web/Dockerfile.railway -t neo-web-railway .
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages ./packages
COPY apps/web ./apps/web
COPY apps/api/package.json ./apps/api/package.json
# Sin scripts: la web no necesita el cliente de Prisma; los paquetes compartidos se compilan a mano.
RUN npm ci --ignore-scripts && npm run build:packages
RUN npm run build -w @neo/web

FROM caddy:2-alpine
COPY deploy/Caddyfile.railway /etc/caddy/Caddyfile
COPY --from=build /app/apps/web/dist /srv
EXPOSE 8080
