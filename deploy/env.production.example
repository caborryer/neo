# Copia este archivo a .env.production (NO lo subas a git) y completa todos los valores.

# Dominio público, sin https:// (p. ej. neo.midominio.com). Debe apuntar por DNS a este servidor.
SITE_ADDRESS=neo.midominio.com

# Base de datos
POSTGRES_PASSWORD=genera-una-clave-larga

# Secretos de sesión: distintos entre sí, mínimo 32 caracteres. Genera cada uno con: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Correo saliente (invitaciones y recuperación de contraseña): usa el SMTP de tu proveedor.
SMTP_HOST=smtp.proveedor.com
SMTP_PORT=587
# true solo si el proveedor usa TLS directo (puerto 465); con 587 déjalo en false (STARTTLS).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Neo <no-reply@midominio.com>"

# Tamaño máximo de las fotos del diario, en MB
MAX_UPLOAD_MB=5
