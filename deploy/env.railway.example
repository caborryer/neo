# Variables para Railway. NO es un archivo que Railway lea: copia cada bloque en el panel de su servicio
# (servicio → Variables → "Raw Editor"). Los valores ${{...}} son referencias de Railway entre servicios.
# Nombres de servicio que se asumen: Postgres, api, web (si los nombras distinto, ajusta las referencias).

# ───────────── Servicio: api ─────────────
NODE_ENV=production
PORT=3000
API_PORT=3000
# Red privada de Railway: debe escuchar en "::" (IPv4 + IPv6).
API_HOST=::
DATABASE_URL=${{Postgres.DATABASE_URL}}
# Dominio público de la web (https). Si luego usas dominio propio, cámbialo aquí.
WEB_ORIGIN=https://${{web.RAILWAY_PUBLIC_DOMAIN}}
# Genera cada uno con: openssl rand -hex 32   (deben ser distintos entre sí)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# La IP real de la usuaria la pone el borde de Railway en x-real-ip (para el límite de intentos de login).
CLIENT_IP_HEADER=x-real-ip
TRUST_PROXY=0
# Fotos: el volumen del servicio api se monta en esta ruta.
STORAGE_DIR=/data/storage
MAX_UPLOAD_MB=5
# Correo por API HTTPS (Railway bloquea SMTP fuera del plan Pro). Crea la clave en resend.com y verifica tu dominio.
MAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_FROM="neoTRAINING <no-reply@tudominio.com>"
# Aplica migraciones al arrancar.
RUN_MIGRATIONS=true
# SOLO EN EL PRIMER DESPLIEGUE: crea la Coach. Cuando entres, cambia RUN_SEED a false y BORRA estas tres variables.
RUN_SEED=true
SEED_COACH_EMAIL=coach@tudominio.com
SEED_COACH_PASSWORD=
# SEED_COACH_FIRST_NAME=
# SEED_COACH_LAST_NAME=

# ───────────── Servicio: web ─────────────
PORT=8080
# Dirección privada de la API (nombre del servicio + puerto).
API_UPSTREAM=api.railway.internal:3000
